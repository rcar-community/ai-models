From bb460ed4f61aa64b9fc99c64f291d2e967c12b35 Mon Sep 17 00:00:00 2001
From: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
Date: Mon, 26 Oct 2026 18:43:50 +0900
Subject: [PATCH 06/15] DEV: ci: Add build test workflow using kas

Add a separate workflow to build minimal and weston images with
build-with-kas.sh on *-dev and *-next branches.

Signed-off-by: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
---
 .github/workflows/build_test_kas.yaml | 54 +++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 .github/workflows/build_test_kas.yaml

diff --git a/.github/workflows/build_test_kas.yaml b/.github/workflows/build_test_kas.yaml
new file mode 100644
index 0000000..59e8d63
--- /dev/null
+++ b/.github/workflows/build_test_kas.yaml
@@ -0,0 +1,54 @@
+name: Build test for Sparrow-hawk (kas)
+run-name: Build test for Sparrow-hawk (kas)
+on:
+  push:
+    branches:
+      - '*-dev'
+      - '*-next'
+  workflow_dispatch:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  Build:
+    name: Build (${{ matrix.name }})
+    if: github.repository_owner == 'rcar-community'
+    runs-on: ubuntu-24.04-arm
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - name: minimal
+            commands: |
+              ./build-with-kas.sh --minimal --rm-work
+          - name: weston
+            commands: |
+              ./build-with-kas.sh --weston --rm-work
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v7
+
+      - name: Setup build environment
+        uses: ./.github/workflows/setup_build_env
+
+      - name: Install kas
+        shell: bash
+        run: pip3 install --break-system-packages kas
+
+      - name: Run build
+        shell: bash
+        run: ${{ matrix.commands }}
+
+      - name: Upload build logs
+        if: failure()
+        uses: actions/upload-artifact@v7
+        with:
+          name: bitbake-logs-${{ github.workflow }}-${{ github.run_attempt }}-${{ matrix.name }}
+          path: |
+            kas-work/build/tmp/log/cooker/
+            kas-work/build/tmp/work/*/*/*/temp/log.do_*
+            kas-work/build/tmp/work/*/*/*/temp/run.do_*
+          if-no-files-found: warn
+          retention-days: 14
