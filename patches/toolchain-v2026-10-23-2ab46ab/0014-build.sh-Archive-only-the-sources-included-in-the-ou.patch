From 7666bc9c333693a51134a4b842a14c8cffccb788 Mon Sep 17 00:00:00 2001
From: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
Date: Thu, 29 Oct 2026 15:59:19 +0900
Subject: [PATCH 14/15] build.sh: Archive only the sources included in the
 output

The archiver class archives the source of all recipe types by default,
including native and cross recipes. They are used only for the build and
are not included in the image, so the sources are not needed to be
provided. Limit the archive to the target recipes.

The SDK installer includes nativesdk and cross-canadian (gcc, binutils)
recipes. Add them when --sdk is specified.

Signed-off-by: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
---
 build.sh | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/build.sh b/build.sh
index 3e8c9ef..4f488ed 100755
--- a/build.sh
+++ b/build.sh
@@ -126,6 +126,18 @@ ARCHIVER_MODE[src] = "original"
 ARCHIVER_MODE[diff] = "1"
 ARCHIVER_MODE[recipe] = "1"
 EOS
+# The native and cross recipes are not distributed. The SDK installer
+# includes nativesdk and cross-canadian (gcc, binutils) recipes.
+if [[ "${IS_BUILD_SDK}" == "yes" ]]; then
+    COPYLEFT_RECIPE_TYPES="target nativesdk cross-canadian"
+else
+    COPYLEFT_RECIPE_TYPES="target"
+fi
+cat << EOS >> conf/local.conf
+
+# optional. archive the source only of the recipes included in the output.
+COPYLEFT_RECIPE_TYPES = "${COPYLEFT_RECIPE_TYPES}"
+EOS
 else # Disable SBOM build to reduce build time
 cat << EOS >> conf/local.conf
 # Disable create-spdx
